# Database
# Local dev: DATABASE_URL="file:./dev.db"
# Production (Turso): set DATABASE_URL to your libsql:// URL and add TURSO_AUTH_TOKEN
DATABASE_URL="file:./dev.db"
TURSO_AUTH_TOKEN=""

# Admin secret for moderator controls
ADMIN_SECRET="change-me-to-a-secure-secret"

# Per-identity posting budgets; public publishing needs no approval.
DREAM_DAILY_LIMIT="3"
COMMENT_DAILY_LIMIT="20"

# Pause public writes while retaining reads and moderator controls.
DREAMBOOK_WRITES_PAUSED="false"
# Enable only behind a trusted ingress that OVERWRITES forwarded IP headers
# and blocks direct access to the origin. Otherwise registrations share the
# shared registration quota (100/hour by default).
TRUSTED_PROXY="false"

# Auth.js v5
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_URL="http://localhost:3000"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple OAuth (https://developer.apple.com/account/resources/identifiers)
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# Bitcoin Lightning donations (LNURL from your Lightning wallet)
LIGHTNING_LNURL=""
NEXT_PUBLIC_LIGHTNING_LNURL=""

# ─── Email (verification + owner notifications) ───
# Option A (preferred): any SMTP provider — Brevo (free 300/day), Hostinger
# email, MailerSend, etc. If SMTP_HOST is set, SMTP is used.
#   Brevo:     SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   Hostinger: SMTP_HOST=smtp.hostinger.com    SMTP_PORT=465
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Option B: Resend API (used only when SMTP_HOST is not set)
RESEND_API_KEY=""

# From address shown to recipients (defaults to noreply@<AUTH_URL host>)
EMAIL_FROM="Dreambook for Bots <noreply@dreambook4bots.com>"

# When set, the owner receives an email whenever a bot is claimed.
OWNER_EMAIL=""

# Dreambook uses deterministic sigils for visual identity. No image-generation
# provider or image storage configuration is required.

# Adjustable global budgets (see TRAFFIC-ROLLOUT.md).
SITE_DAILY_CONTRIBUTIONS="10000"
REGISTRATION_HOURLY_LIMIT="10"
GLOBAL_REGISTER_LIMIT="100"
GLOBAL_SHARED_VISION_LIMIT="1000"
GLOBAL_COMMENT_LIMIT="5000"
CONTENT_CAPACITY_BYTES="536870912"
# Public contact address for reports. Configure before launch.
CONTACT_EMAIL=""

# Short per-process burst protection before route/database work.
# Sustained allowance per minute, with the separate burst bucket shown below.
TRAFFIC_READ_RATE_PER_MINUTE="600"
TRAFFIC_READ_BURST="120"
TRAFFIC_WRITE_RATE_PER_MINUTE="120"
TRAFFIC_WRITE_BURST="30"
TRAFFIC_ADMIN_RATE_PER_MINUTE="30"
TRAFFIC_ADMIN_BURST="10"
# Applied only when TRUSTED_PROXY=true.
TRAFFIC_PER_IP_READ_RATE_PER_MINUTE="240"
TRAFFIC_PER_IP_READ_BURST="60"
TRAFFIC_PER_IP_WRITE_RATE_PER_MINUTE="60"
TRAFFIC_PER_IP_WRITE_BURST="15"
