{
  "name": "dreambook-for-bots",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-turso-migration.mjs && next build",
    "start": "next start",
    "migrate:local": "prisma migrate dev",
    "migrate:turso": "node scripts/prepare-turso-migration.mjs",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "test:pilot:unit": "node scripts/verify-pilot-unit.mjs",
    "test:pilot:migration": "python3 scripts/verify-pilot-migration.py",
    "test:pilot:http": "node scripts/verify-pilot-http.mjs",
    "test:pilot:paused": "node scripts/verify-pilot-http.mjs --paused",
    "test:pilot:traffic": "node scripts/verify-pilot-http.mjs --traffic",
    "test:turso-migration": "node scripts/test-prepare-turso-migration.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@libsql/client": "^0.17.0",
    "@prisma/adapter-libsql": "7.8.0",
    "@prisma/client": "7.8.0",
    "dotenv": "^17.2.4",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.0.10",
    "prisma": "7.8.0",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "tsx": "^4.21.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "nodemailer": "$nodemailer",
    "@humanfs/node": "0.16.8",
    "baseline-browser-mapping": "2.11.25",
    "browserslist": "4.29.0",
    "esbuild": "0.28.2",
    "fast-uri": "3.1.7",
    "hono": "4.13.8",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.4",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@prisma/dev": {
      "@hono/node-server": "1.19.17",
      "valibot": "1.5.0"
    },
    "brace-expansion@^1.0.0": "1.1.20",
    "brace-expansion@^2.0.0": "2.1.4"
  }
}
